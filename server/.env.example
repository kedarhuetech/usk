# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/api/auth/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Meta / Facebook & Instagram Integration
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_LOGIN_CONFIG_ID=your-meta-config-id
META_REDIRECT_URI=http://localhost:5000/api/auth/meta/callback

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=vyapaar
DB_PORT=3306

# Calendarific Festival Calendar API
# Portal: https://calendarific.com/
CALENDARIFIC_API_KEY=your-calendarific-key

# ==============================================================================
# USV Marketing Studio - Stock Media Provider Configuration
# ==============================================================================
# Security: Keep these keys strictly on the server. They are never sent to the browser.
#
# 1. Pexels API
#    - How to obtain: Sign up at https://www.pexels.com/api/ and generate an API key.
#    - Environment variable: PEXELS_API_KEY
#    - Quota: Free tier includes 200 requests/hour, up to 20,000 requests/month.
#    - Verification: Test via GET /api/marketing-studio/stock-media?provider=pexels&query=business
#
# 2. Pixabay API
#    - How to obtain: Register at https://pixabay.com/api/docs/ and find your key under "Parameters".
#    - Environment variable: PIXABAY_API_KEY
#    - Quota: Free tier provides 100 requests per minute.
#    - Verification: Test via GET /api/marketing-studio/stock-media?provider=pixabay&query=business
#
# 3. Unsplash API
#    - How to obtain: Register at https://unsplash.com/developers, create an app, and copy the Access Key.
#    - Environment variable: UNSPLASH_ACCESS_KEY
#    - Quota: Demo tier allows 50 requests/hour; production tier allows 5,000 requests/hour.
#    - Verification: Test via GET /api/marketing-studio/stock-media?provider=unsplash&query=business
#
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
