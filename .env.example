# Google OAuth web client used by the server-side Drive backup flow and Google Profile Manager.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Register these exact URIs in Google Cloud Console.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/api/auth/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# USV Marketing Tools - Stock Media API Keys (Configured in server/.env)
# -----------------------------------------------------------------------
# 1. Pexels API Key
#    - Portal: https://www.pexels.com/api/
#    - Variable: PEXELS_API_KEY
# 2. Pixabay API Key
#    - Portal: https://pixabay.com/api/docs/
#    - Variable: PIXABAY_API_KEY
# 3. Unsplash Access Key
#    - Portal: https://unsplash.com/developers
#    - Variable: UNSPLASH_ACCESS_KEY
PEXELS_API_KEY=your-pexels-api-key
PIXABAY_API_KEY=your-pixabay-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
