# Google OAuth web client used by the server-side Drive backup flow.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Register this exact URI in Google Cloud Console. In local development, /api is proxied by Vite.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/api/auth/google-drive/callback
