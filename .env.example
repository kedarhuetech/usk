# Google OAuth web client used by the server-side Drive backup flow and Google Profile Manager.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Register these exact URIs in Google Cloud Console.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/api/auth/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
